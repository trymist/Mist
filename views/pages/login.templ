package pages

import "mist/views/layouts"

templ Login() {
	@layouts.Base("Login") {
		<div class="h-screen bg-zinc-950 flex overflow-hidden">
			<div class="hidden lg:flex lg:w-1/2 relative overflow-hidden border-r border-zinc-900">
				<div class="absolute inset-0 bg-zinc-950"></div>
				<div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-sky-500/10 blur-3xl"></div>
				<div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl"></div>
				<div class="relative z-10 flex flex-col justify-center px-16 xl:px-20">
					<img
						src="/public/mist.png"
						alt="Mist"
						class="w-16 h-16 xl:w-24 xl:h-24 mb-6"
					/>
					<h1 class="text-4xl xl:text-6xl font-bold tracking-tight text-white">
						Mist
					</h1>
					<p class="mt-4 max-w-lg text-lg xl:text-xl leading-relaxed text-zinc-400">
						Self-host your applications with the simplicity of Vercel and
						the freedom of owning your infrastructure.
					</p>
					<div class="mt-10 flex gap-8">
						<div>
							<p class="font-semibold text-white">Deploy</p>
							<p class="text-sm text-zinc-500">Git Push → Production</p>
						</div>
						<div>
							<p class="font-semibold text-white">Scale</p>
							<p class="text-sm text-zinc-500">Docker Native</p>
						</div>
						<div>
							<p class="font-semibold text-white">Own</p>
							<p class="text-sm text-zinc-500">Your Infrastructure</p>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full lg:w-1/2 flex items-center justify-center p-4 md:p-6"
				x-data="{ loading: false }"
			>
				<div class="w-full max-w-md">
					<div class="lg:hidden flex justify-center mb-6">
						<img
							src="/public/mist.png"
							alt="Mist"
							class="w-14 h-14"
						/>
					</div>
					<div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 backdrop-blur-xl p-5 md:p-6 shadow-2xl">
						<h2 class="text-2xl md:text-3xl font-bold text-white">
							Welcome back
						</h2>
						<p class="mt-2 text-sm text-zinc-400">
							Sign in to continue managing your applications.
						</p>
						<form
							class="mt-6 space-y-4"
							hx-post="/api/login"
							hx-target="#login-error"
							hx-swap="innerHTML"
							@htmx:before-request="loading = true"
							@htmx:after-request="loading = false"
							@htmx:response-error="loading = false"
						>
							<div>
								<label
									for="username"
									class="mb-1 block text-xs font-medium uppercase tracking-wide text-zinc-400"
								>
									Username
								</label>
								<input
									type="text"
									id="username"
									name="username"
									placeholder="johndoe"
									required
									class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-white placeholder:text-zinc-500 focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/10 transition"
								/>
							</div>
							<div>
								<label
									for="password"
									class="mb-1 block text-xs font-medium uppercase tracking-wide text-zinc-400"
								>
									Password
								</label>
								<input
									type="password"
									id="password"
									name="password"
									placeholder="••••••••"
									required
									class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-white placeholder:text-zinc-500 focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/10 transition"
								/>
							</div>
							<div
								id="login-error"
								class="text-sm text-red-400"
							></div>
							<button
								type="submit"
								:disabled="loading"
								class="w-full rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 py-2.5 font-medium text-white transition-all duration-200 hover:from-sky-400 hover:to-blue-500 hover:shadow-lg hover:shadow-sky-500/20 disabled:opacity-50 disabled:cursor-not-allowed"
							>
								<span x-show="!loading">
									Sign in
								</span>
								<span x-show="loading">
									Signing in...
								</span>
							</button>
						</form>
						<p class="mt-5 text-center text-sm text-zinc-500">
							Don't have an account?
							<a
								href="/register"
								class="font-medium text-white hover:text-zinc-300 transition"
							>
								Create one
							</a>
						</p>
					</div>
				</div>
			</div>
		</div>
	}
}
